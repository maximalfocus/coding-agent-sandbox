{
  "permissions": {
    "allow": [
      "Bash(./allow-domain.sh:*)",
      "Bash(./allow-domain.ps1:*)",
      "Bash(./audit.sh:*)",
      "Bash(docker compose exec:*)",
      "Bash(grep:*)",
      "Bash(perl:*)",
      "Read(./*)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        "**/.env",
        "**/.env.*"
      ]
    }
  }
}
