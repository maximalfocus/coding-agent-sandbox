# Copy to .env and edit. ` cp .env.example .env `

# Absolute path to the project you want Claude Code to work on, mounted at /workspace.
#   macOS/Linux example: /Users/you/code/my-project
#   Windows example:     C:/Users/yourname/projects/your-project   (forward slashes)
WORKSPACE_DIR=./workspace

# OPTIONAL — work across two whole project trees in one session. If set, each is mounted at
# /workspace/personal and /workspace/work. Skill repos (skills-setup) are cloned into
# /workspace/personal and symlinked into the sandbox's skills — your real host clones, one source of
# truth. Bigger mounts = bigger blast radius, and ALL mounted code is sent to Anthropic when
# Claude reads it (see SECURITY.md) — only point these at trees you're OK sending to the model.
# Leave blank to keep a single /workspace and the isolated skills volume (the default).
#   macOS/Linux:  PERSONAL_DIR=/Users/you/personal        WORK_DIR=/Users/you/work
#   Windows:      PERSONAL_DIR=C:/Users/you/personal      WORK_DIR=C:/Users/you/work   (forward slashes)
PERSONAL_DIR=
WORK_DIR=

# Web-terminal login. CHANGE THESE before exposing anything.
TTYD_USER=coder
TTYD_PASS=please-change-me

# Local port for the browser terminal -> http://127.0.0.1:7681
TTYD_PORT=7681

# Permit official download/package endpoints for deliberate upgrades of bundled and common tools:
# AWS CLI, Bun/Node, Python/uv, Rust/Cargo, Maven/Gradle, apt, and Playwright. npm-hosted upgrades
# already use the base npm allowlist; GitHub-hosted release assets still require ALLOW_GITHUB=true.
# This is a supply-chain capability grant, so disable it for untrusted workspaces. Image-pinned,
# root-owned CLIs still upgrade by bumping Dockerfile versions and rebuilding, not in place.
ALLOW_TOOL_UPGRADES=true

# Extra domains Claude is allowed to reach (comma-separated, no spaces needed). Use this only for
# project-specific registries/docs not covered by the switches. The auto-watcher (watch-egress
# --auto) catches anything missing at runtime.
EXTRA_ALLOWED_DOMAINS=

# GitHub egress (github.com + githubusercontent.com). It's a CAPABILITY, not just a destination:
# a general bidirectional channel an injected agent could exfiltrate through within policy.
# Left ON for normal coding; set to false for analysis-only or untrusted-workspace sessions.
ALLOW_GITHUB=true

# Full GitHub access (clone/pull/PUSH) inside the sandbox. SSH (port 22) is blocked, so this is
# done over HTTPS with a token. Set GITHUB_TOKEN to a Personal Access Token — a fine-grained PAT
# scoped to just your repos (Contents: read/write) is safest; a classic `repo`-scope token also
# works. SSH github remotes (git@github.com:...) are auto-rewritten to HTTPS. Needs ALLOW_GITHUB=true.
# NOTE: the token is readable by the agent inside the sandbox — scope it narrowly; it can be revoked.
#
# PUSHING GITHUB ACTIONS WORKFLOWS (.github/workflows/*) NEEDS AN EXTRA SCOPE. GitHub rejects any
# push (and Contents-API write) that creates/updates a workflow file unless the token carries the
# classic `workflow` scope (in ADDITION to `repo`), or — for a fine-grained PAT — `Workflows:
# read and write`. A plain `repo`/Contents token pushes everything else fine, then fails ONLY on
# the workflow files ("refusing to allow ... without `workflow` scope"). CDD implementation repos
# ship a CI workflow, so this bites on first push. A classic PAT's scopes are FIXED at creation —
# you cannot add a scope from inside the sandbox.
#
# RECOMMENDED PERMANENT FIX: run `./scripts/auth/gh-login.sh` once. It logs in the bundled GitHub CLI via the
# device flow; gh's token carries the `workflow` scope, the login persists in the gh-config volume,
# and the entrypoint wires git to use it on every start — so you never hit the workflow wall again
# (gh is preferred over GITHUB_TOKEN when present). GITHUB_TOKEN below stays a fine fallback for
# clone/pull and non-workflow pushes; the entrypoint warns at startup if it lacks `workflow`.
# GITHUB_TOKEN=github_pat_xxx
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# Skill repos to clone INTO the sandbox so /cdd, /peer-review, etc. work AND their *-evolve
# commands can commit/push to GitHub. Space-separated HTTPS git URLs. After setting this and
# starting the sandbox, run ./scripts/skills/skills-setup.sh (or scripts/skills/skills-setup.cmd on Windows). Re-run to pull
# the latest. (Use this for git skill repos you want to evolve; scripts/skills/sync-skills.sh just copies skills
# for read-only use.) Pushing needs GITHUB_TOKEN with write access to those repos.
# SKILL_REPOS=https://github.com/you/cdd-skills.git https://github.com/you/peerreview-skills.git

# peerreview self-evolves + pushes peerreview-skills after EVERY run. To avoid git races when more
# than one environment runs it (e.g. this sandbox + your host), make ONE environment the evolver and
# set PEERREVIEW_EVOLVE=off on the others (they then log-only, no commit/push). Unset = this env evolves.
# PEERREVIEW_EVOLVE=off

# OpenAI/Codex egress (api/auth.openai.com + chatgpt.com). Enables the bundled Codex CLI for
# cross-vendor peer review. Off by default (another vendor your code can flow to); set true to
# use it, then run ./scripts/auth/codex-login.sh once to sign in with your ChatGPT/OpenAI subscription.
ALLOW_OPENAI=true

# Resource ceilings so a runaway build/agent can't exhaust your machine.
MEM_LIMIT=6g
PIDS_LIMIT=4096

# --- Supply-chain scan (run.sh) -------------------------------------------------------------
# ./run.sh scans the built image with Trivy. It's ADVISORY by default — it prints fixed
# HIGH/CRITICAL findings but does NOT block startup (a full Debian+Node base plus third-party
# CLIs always carries some you can't patch). Opt into blocking, tune severities, or skip:
# TRIVY_STRICT=1            # fail the start if any fixed HIGH/CRITICAL remain
# TRIVY_SEVERITY=HIGH,CRITICAL
# SKIP_TRIVY=1              # skip the scan entirely (e.g. offline, no DB cached)

# --- Audit-log rotation (stays on this machine) ---------------------------------------------
# The egress trail lives in the claude-audit volume. Defaults cap it at ~100 MiB total
# (5 files x 20 MiB). Use ./audit.sh --export to back it up off the volume.
# AUDIT_LOG_MAX_BYTES=20971520
# AUDIT_LOG_KEEP=5
# AUDIT_ROTATE_INTERVAL=3600

# Remote control (/rc). Telemetry + Anthropic feature-flag egress is OFF by default (hardened),
# which also gates /remote-control since the feature is feature-flag-gated. Uncomment the line
# below (set EMPTY) to re-enable that traffic — to already-allowlisted Anthropic hosts — and
# unlock /rc. Leave it commented/unset to keep telemetry off.
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=
