# OPT-IN content-mediation variant: adds mitmproxy (a TLS-intercepting egress proxy) on top of the
# default sandbox image. Heavier than the default (pulls Python + mitmproxy), so it's a separate
# image you build only when you want request-content mediation — per-method/path rules (e.g. GitHub
# read-only), credential-header stripping, and full request logging — instead of hostname-only
# filtering. Build/run with:  docker compose -f docker-compose.mitm.yml up -d --build
FROM claude-container-sandbox:latest
USER root

# The base image bakes HTTP(S)_PROXY=127.0.0.1:8888 for runtime; that proxy isn't up at build
# time, so clear it for this network step (build-time egress is direct, same as the base image).
RUN http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= no_proxy='*' \
      apt-get update && http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= no_proxy='*' \
      apt-get install -y --no-install-recommends mitmproxy \
    && rm -rf /var/lib/apt/lists/*

# mitmproxy's CA + config dir, owned by the egress user it runs as.
RUN mkdir -p /etc/mitmproxy && chown tinyproxy:tinyproxy /etc/mitmproxy

COPY mitm/filter_addon.py /usr/local/share/mitm/filter_addon.py
COPY mitm/entrypoint.sh   /usr/local/bin/entrypoint-mitm.sh
RUN chmod +x /usr/local/bin/entrypoint-mitm.sh

# Make the intercept CA trusted by the whole toolchain. The system bundle is refreshed at runtime
# (update-ca-certificates) once the CA is generated. curl/git/python read the system bundle below;
# Node is the tricky one — its bundled-CA `fetch`/undici ignores NODE_EXTRA_CA_CERTS in some
# versions, so --use-openssl-ca makes Node trust the system OpenSSL store (where the mitm CA lands).
# NODE_EXTRA_CA_CERTS is kept as a belt-and-braces fallback.
ENV NODE_OPTIONS=--use-openssl-ca \
    NODE_EXTRA_CA_CERTS=/etc/mitmproxy/mitmproxy-ca-cert.pem \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt

# Override the base image's healthcheck (which greps for `tinyproxy`): this variant runs mitmdump.
# Healthy = mitmdump alive AND filtering both layers: a non-allowlisted host is 403 over plain HTTP
# AND its HTTPS CONNECT is refused (curl fails) — the latter catches a CONNECT-gate regression.
HEALTHCHECK --interval=30s --timeout=10s --start-period=25s --retries=3 \
  CMD pgrep -x mitmdump >/dev/null 2>&1 \
      && [ "$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 -x http://127.0.0.1:8888 http://example.com/ 2>/dev/null)" = "403" ] \
      && [ "$(curl -s -o /dev/null -w '%{http_connect}' --connect-timeout 5 -x http://127.0.0.1:8888 https://example.com/ 2>/dev/null)" = "403" ]

ENTRYPOINT ["/usr/local/bin/entrypoint-mitm.sh"]
