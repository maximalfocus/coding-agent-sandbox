#!/usr/bin/env python3
"""Provision, validate, report, or revoke the sidecar-only DeepSeek API key."""

import argparse
import hashlib
import os
import pwd
import stat
import sys
import tempfile


DEFAULT_PATH = "/var/lib/sandbox/deepseek/api-key"
PLACEHOLDER = "sandbox-placeholder-do-not-use"
MAX_KEY_BYTES = 16 * 1024


class SecretError(RuntimeError):
    pass


def _owner():
    """Use tinyproxy in the container; stay testable as the current user off-container."""
    if os.geteuid() == 0:
        try:
            account = pwd.getpwnam("tinyproxy")
            return account.pw_uid, account.pw_gid
        except KeyError as exc:
            raise SecretError("tinyproxy account is unavailable") from exc
    return os.geteuid(), os.getegid()


def _validate_value(raw):
    if len(raw) > MAX_KEY_BYTES:
        raise SecretError("key exceeds the size limit")
    # Accept one line ending from an interactive/pipeline transport, but never silently collapse
    # multiple lines into a credential.
    if raw.endswith(b"\r\n"):
        raw = raw[:-2]
    elif raw.endswith(b"\n"):
        raw = raw[:-1]
    try:
        value = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise SecretError("key must be UTF-8 text") from exc
    if not value:
        raise SecretError("key is empty")
    if value == PLACEHOLDER:
        raise SecretError("placeholder is not a usable key")
    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value):
        raise SecretError("key contains control characters or multiple lines")
    if value != value.strip():
        raise SecretError("key has leading or trailing whitespace")
    return value


def _secure_dir(path, uid, gid, create=False):
    directory = os.path.dirname(path)
    if create:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        try:
            initial = os.lstat(directory)
        except OSError as exc:
            raise SecretError("secret directory is unavailable") from exc
        if not stat.S_ISDIR(initial.st_mode) or stat.S_ISLNK(initial.st_mode):
            raise SecretError("secret directory is not a real directory")
        if os.geteuid() == 0:
            current_owner = initial.st_uid
            if current_owner == 0:
                # The hardened sidecar drops CAP_FOWNER. Set the mode before transferring a fresh
                # Docker volume away from root.
                os.chmod(directory, 0o700)
                os.chown(directory, uid, gid)
            elif current_owner == uid:
                # Recover cleanly if an earlier provision was interrupted after chown but before
                # chmod: perform chmod as the actual owner, using the retained SETUID capability.
                os.seteuid(uid)
                try:
                    os.chmod(directory, 0o700)
                finally:
                    os.seteuid(0)
            else:
                raise SecretError("secret directory has an unexpected owner")
        else:
            os.chmod(directory, 0o700)
    try:
        info = os.lstat(directory)
    except OSError as exc:
        raise SecretError("secret directory is unavailable") from exc
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise SecretError("secret directory is not a real directory")
    if info.st_uid != uid or stat.S_IMODE(info.st_mode) != 0o700:
        raise SecretError("secret directory owner or mode is unsafe")
    return directory


def read_secure(path, uid):
    _secure_dir(path, uid, _owner()[1])
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        raise SecretError("key file is missing, unreadable, or unsafe") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise SecretError("key path is not a regular file")
        if info.st_uid != uid or stat.S_IMODE(info.st_mode) != 0o600:
            raise SecretError("key file owner or mode is unsafe")
        raw = os.read(fd, MAX_KEY_BYTES + 1)
        if os.read(fd, 1):
            raise SecretError("key exceeds the size limit")
    finally:
        os.close(fd)
    return _validate_value(raw)


def store(path):
    raw = sys.stdin.buffer.read(MAX_KEY_BYTES + 2)
    value = _validate_value(raw)
    uid, gid = _owner()
    directory = _secure_dir(path, uid, gid, create=True)
    fd, temporary = tempfile.mkstemp(prefix=".api-key.", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        if os.geteuid() == 0:
            os.fchown(fd, uid, gid)
        os.write(fd, value.encode("utf-8"))
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(temporary, path)
        read_secure(path, uid)
    except Exception:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
    print("DeepSeek key stored in sidecar-only storage (mode 0600).")


def validate(path, quiet=False):
    uid, _ = _owner()
    value = read_secure(path, uid)
    if not quiet:
        fingerprint = hashlib.sha256(value.encode("utf-8")).hexdigest()[:12]
        print(f"DeepSeek key is valid (sha256:{fingerprint}).")


def delete(path):
    uid, gid = _owner()
    _secure_dir(path, uid, gid)
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        print("DeepSeek key is already absent.")
        return
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise SecretError("refusing to remove a non-regular key path")
    os.unlink(path)
    print("DeepSeek key revoked from sidecar-only storage.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("store", "validate", "status", "delete"))
    parser.add_argument("--path", default=os.environ.get("DEEPSEEK_KEY_PATH", DEFAULT_PATH))
    args = parser.parse_args()
    try:
        if args.command == "store":
            store(args.path)
        elif args.command in ("validate", "status"):
            validate(args.path, quiet=args.command == "validate")
            if args.command == "status":
                print("DeepSeek key status: ready.")
        else:
            delete(args.path)
    except SecretError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
